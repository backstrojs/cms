{
	"name": "@backstro/cms",
	"version": "0.0.8",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"license": "MIT",
	"files": [
		"dist",
		"bin",
		"scripts"
	],
	"scripts": {
		"build": "node ./scripts/build-dist.mjs"
	},
	"bin": {
		"cms": "./bin/cms.js"
	},
	"repository": {
		"url": "https://github.com/backstrojs/cms"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./admin/components/ui/*": {
			"types": "./dist/admin/components/ui/*/index.d.ts",
			"default": "./dist/admin/components/ui/*/index.js"
		},
		"./admin/*": "./dist/admin/*",
		"./auth": {
			"types": "./dist/auth/index.d.ts",
			"default": "./dist/auth/index.js"
		},
		"./auth/client": {
			"types": "./dist/auth/client.d.ts",
			"default": "./dist/auth/client.js"
		},
		"./client/global.css": "./dist/assets/global.css",
		"./sdk": {
			"types": "./dist/admin/sdk.d.ts",
			"default": "./dist/admin/sdk.js"
		},
		"./collections": {
			"types": "./dist/collections.d.ts",
			"default": "./dist/collections.js"
		},
		"./config": {
			"types": "./dist/config.d.ts",
			"default": "./dist/config.js"
		},
		"./email": {
			"types": "./dist/email.d.ts",
			"default": "./dist/email.js"
		},
		"./db": {
			"types": "./dist/db/index.d.ts",
			"default": "./dist/db/index.js"
		}
	},
	"dependencies": {
		"@backstro/email": "^0.0.2",
		"@better-auth/cli": "^1.4.21",
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-html": "^6.4.11",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-markdown": "^6.5.0",
		"@codemirror/lang-php": "^6.0.2",
		"@codemirror/lang-python": "^6.2.1",
		"@codemirror/lang-sql": "^6.10.0",
		"@minimajs/disk": "^0.0.3",
		"@zenstackhq/cli": "^3.5.5",
		"@zenstackhq/language": "^3.5.5",
		"@zenstackhq/orm": "^3.5.5",
		"better-auth": "^1.6.2",
		"bits-ui": "^2.16.3",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"file-selector": "^2.1.2",
		"lucide-static": "^0.577.0",
		"nodemailer": "^8.0.1",
		"sortablejs": "^1.15.7",
		"sv-router": "^0.14.1",
		"svelte-codemirror-editor": "^2.1.0",
		"tailwindcss": "^4.2.2",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tsx": "^4.20.6",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@tailwindcss/cli": "^4.2.2",
		"@types/nodemailer": "^7.0.11",
		"@types/sortablejs": "^1.15.9",
		"@zenstackhq/common-helpers": "^3.5.5",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"@lucide/svelte": "^1.7.0",
		"astro": "^6.0.0",
		"kysely": "^0.28.5",
		"svelte": "^5"
	}
}
